APP_NAME="Kotinäyttö"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://127.0.0.1:8095

APP_LOCALE=fi
APP_FALLBACK_LOCALE=fi
APP_FAKER_LOCALE=fi_FI

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=homepanel
DB_USERNAME=homepanel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

GOOGLE_CALENDAR_API_KEY=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="homepanel@localhost"
MAIL_FROM_NAME="${APP_NAME}"

HOMEPANEL_ADMIN_USERNAME=
HOMEPANEL_ADMIN_PASSWORD=
HOMEPANEL_ADMIN_NAME=Ylläpitäjä
